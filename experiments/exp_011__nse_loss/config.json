{
  "seed": 42,
  "optimizer": "adamw",
  "lr": 0.0001,
  "weight_decay": 0.0001,
  "combiner_lr_mult": 1.0,
  "scheduler": "warmup_cosine",
  "warmup_frac": 0.05,
  "eta_min": 1e-06,
  "sgdr_T0": 20,
  "sgdr_T_mult": 2,
  "batch_size": 64,
  "epochs": 40,
  "loss": "nse",
  "huber_delta": 1.0,
  "nse_eps": 0.1,
  "aux_task": false,
  "aux_loss_weight": 0.3,
  "use_ceemdan": false,
  "input_channels": null,
  "clip_grad": 1.0,
  "early_stop_patience": 8,
  "early_stop_min_delta": 0.0001,
  "early_stop_metric": "median_nse",
  "norm_strategy": "per_basin_zscore",
  "use_basin_emb": false,
  "basin_emb_dim": 16,
  "num_workers": 0,
  "pin_memory": true
}